{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "RoadSense Mobile",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart"
        },
        {
            "name": "RoadSense Web (Edge)",
            "request": "launch",
            "type": "dart",
            "program": "lib/web_main.dart",
            "args": [
                "-d",
                "edge"
            ]
        },
        {
            "name": "RoadSense Web (Brave)",
            "request": "launch",
            "type": "dart",
            "program": "lib/web_main.dart",
            "args": [
                "-d",
                "chrome"
            ],
            "env": {
                "CHROME_EXECUTABLE": "C:\\Users\\jenar\\AppData\\Local\\BraveSoftware\\Brave-Browser\\Application\\brave.exe"
            }
        },
        {
            "name": "Launch Edge against localhost:8080",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        }
    ]
}